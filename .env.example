# String de conexão com o banco PostgreSQL (Supabase).
# Em produção/preview, use a variável POSTGRES_URL fornecida automaticamente pela integração Supabase.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventpoint

# Chave da API da OpenAI (necessária para transcrição de áudios via Whisper)
OPENAI_API_KEY=your_openai_api_key_here

# Chave secreta para assinatura de tokens JWT
JWT_SECRET=super-secret-jwt-key-eventpoint-2026

# URL base da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
